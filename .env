# Public site URL used for canonical links, Open Graph, sitemap, and robots.
# Example: https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Optional public contact details. Leave blank until verified.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=
NEXT_PUBLIC_CONTACT_ADDRESS=

# Form delivery. Configure one of the following options.
# Option A: Resend
CONTACT_TO_EMAIL=
RESEND_API_KEY=
CONTACT_FROM_EMAIL=

# Option B: Generic webhook that accepts JSON POSTs
CONTACT_WEBHOOK_URL=
